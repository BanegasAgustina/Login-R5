PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=petcare
JWT_SECRET=cambia_esta_clave_por_una_larga_y_segura
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# URL pública de la API. Callback: BACKEND_URL/api/auth/PROVEEDOR/callback.
# CLIENT_URL (arriba) sigue siendo el origen del frontend y de CORS.
# En producción ambas URLs deben usar HTTPS y pertenecer al mismo sitio (SameSite).
BACKEND_URL=http://localhost:3000
# Client ID identifica la app; Client Secret se usa SOLO en el backend.
# Los pares vacíos deshabilitan el proveedor sin simular un acceso.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Copiar la versión Graph API de la app Meta (formato vNN.N); no se presupone una versión.
FACEBOOK_GRAPH_VERSION=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Opcional: directorio persistente en un servidor Node; NO usar /tmp para fotos.
UPLOADS_DIR=
